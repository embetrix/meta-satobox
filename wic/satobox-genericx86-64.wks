# description: Create an EFI disk image for genericx86*
part /             --ondisk sda  --label efi        --fixed-size 50M    --source bootimg-efi --sourceparams="loader=grub-efi" --active --align 1024
part /             --ondisk sda  --label primary    --fixed-size 1024M  --fstype=ext4   --source rootfs
part /             --ondisk sda  --label secondary  --fixed-size 1024M  --fstype=ext4   --source rootfs
part /var/data     --ondisk sda  --label data       --fixed-size 1024M  --fstype=ext4   --fsoptions="noexec,nodev,nosuid"
part /var/wallet   --ondisk sda  --label wallet     --fixed-size 1024M  --fstype=ext4   --fsoptions="noexec,nodev,nosuid"
part /var/backups  --ondisk sda  --label backups    --fixed-size 1024M  --fstype=ext4   --fsoptions="noexec,nodev,nosuid"
part /var/bitcoin  --ondisk sda  --label bitcoin    --fixed-size 20480M --fstype=ext4   --fsoptions="noexec,nodev,nosuid"
bootloader --ptable gpt --configfile=grub.cfg
