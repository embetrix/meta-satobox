[Unit]
Description=Lightning Network Daemon
Wants=network-online.target bitcoind.service
After=network-online.target bitcoind.service systemd-tmpfiles-setup.service

[Service]
DynamicUser=yes
User=lnd
Group=lnd
SupplementaryGroups=bitcoin
StateDirectory=lnd
ExecStartPre=+/bin/sh -c 'mkdir -p /var/lnd && chown lnd:lnd /var/lnd && chmod 0750 /var/lnd'
BindPaths=/var/lnd:/var/lib/lnd
ReadWritePaths=/var/lnd
ExecStart=@bindir@/lnd --configfile=/etc/lnd/lnd.conf
RuntimeDirectory=lnd
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
