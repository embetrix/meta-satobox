[Unit]
Description=Electrum Server
After=bitcoind.service

[Service]
DynamicUser=yes
User=electrs
Group=electrs
SupplementaryGroups=bitcoin
StateDirectory=bitcoin
BindPaths=/var/bitcoin:/var/lib/bitcoin
ReadWritePaths=/var/bitcoin
ExecStart=@bindir@/electrs  --conf /etc/electrs/config.toml
RuntimeDirectory=electrs
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=30
#CPUQuota=150%
#MemoryHigh=1500M
#MemoryMax=1750M

[Install]
WantedBy=multi-user.target
