[Unit]
Description=Cryptoadvance Specter Server
After=electrs.service

[Service]
DynamicUser=yes
User=specter
Group=specter
SupplementaryGroups=plugdev
StateDirectory=specter
BindPaths=/var/specter:/var/lib/specter
Environment=HOME=/var/specter
Environment=SPECTER_DATA_FOLDER=/var/specter
ReadWritePaths=/var/specter
ExecStart=@bindir@/specter server --debug
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
