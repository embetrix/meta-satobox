[Unit]
Description=Cryptoadvance Specter Server
After=electrs.service

[Service]
DynamicUser=yes
User=specter
Group=specter
SupplementaryGroups=plugdev wallets
StateDirectory=specter
BindPaths=/var/specter:/var/lib/specter
Environment=HOME=/var/specter
Environment=WALLETS_DIR=/var/wallets
Environment=SPECTER_DATA_FOLDER=/var/specter
Environment=APP_URL_PREFIX=/specter
Environment=SPECTER_DISABLE_MIGRATIONS=true
ReadWritePaths=/var/specter /var/wallets
ExecStart=@bindir@/specter server --debug
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
