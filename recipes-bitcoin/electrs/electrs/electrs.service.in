[Unit]
Description=Electrum Server
Requires=bitcoind.service
After=bitcoind.service

[Service]
DynamicUser=yes
User=electrs
Group=electrs
SupplementaryGroups=tor
SupplementaryGroups=bitcoin
ReadWritePaths=/var/bitcoin
ExecStart=@bindir@/electrs  --conf /etc/electrs/config.toml
RuntimeDirectory=bitcoin
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
