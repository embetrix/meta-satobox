[Unit]
Description=Bitcoin core daemon service
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target systemd-time-wait-sync.service

[Service]
Type=notify
NotifyAccess=all
DynamicUser=yes
User=bitcoin
Group=bitcoin
SupplementaryGroups=tor wallets
StateDirectory=bitcoin
BindPaths=/var/bitcoin:/var/lib/bitcoin
ReadWritePaths=/var/wallets /var/bitcoin /var/backups
ExecStart=@bindir@/bitcoind -conf=/etc/bitcoin/bitcoin.conf \
                            -startupnotify='systemd-notify --ready' \
                            -shutdownnotify='systemd-notify --stopping'
RuntimeDirectory=bitcoin
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
